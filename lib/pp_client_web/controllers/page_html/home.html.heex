<Layouts.app flash={@flash}>
  <div class="space-y-6 sm:space-y-8">
    <div class="max-w-2xl">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        PP Client
      </h1>
      <p class="mt-2 text-sm text-base-content/70 sm:text-base">
        Local proxy listeners, upstream servers and the rules that route between them.
        Every page below edits the running configuration in memory — save it to a
        <code>pp.exs</code>
        from the Config page to keep it past a restart.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <.link
        :for={section <- sections()}
        navigate={section.path}
        class="card border border-base-300 bg-base-100 shadow-sm transition hover:border-primary/50 hover:shadow-md"
      >
        <div class="card-body gap-2 p-5">
          <h2 class="card-title text-base">
            <span class="rounded-field bg-primary/10 p-2 text-primary">
              <.icon name={section.icon} class="size-5" />
            </span>
            {section.label}
          </h2>
          <p class="text-sm text-base-content/70">{section.blurb}</p>
        </div>
      </.link>
    </div>
  </div>
</Layouts.app>
