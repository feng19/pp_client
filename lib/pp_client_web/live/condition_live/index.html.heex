<Layouts.app flash={@flash}>
  <div class="space-y-4 sm:space-y-6">
    <.header>
      Conditions
      <:subtitle>Manage the proxy routing rules</:subtitle>
      <:actions>
        <button
          phx-click="refresh_cache"
          class="btn btn-outline btn-sm gap-1"
          title="Refresh cache"
        >
          <.icon name="hero-arrow-path" class="size-4" />
          <span class="hidden sm:inline">Refresh cache</span>
          <span class="sm:hidden">Refresh</span>
        </button>
        <button
          phx-click="toggle_connect_failed"
          class="btn btn-outline btn-sm gap-1"
          aria-expanded={to_string(@show_connect_failed)}
        >
          <.icon name="hero-exclamation-triangle" class="size-4" />
          <span class="hidden sm:inline">Failed connections</span>
          <span class="sm:hidden">Failed</span>
          <span :if={@connect_failed_hosts != []} class="badge badge-error badge-sm">
            {length(@connect_failed_hosts)}
          </span>
          <.icon
            name={if @show_connect_failed, do: "hero-chevron-up", else: "hero-chevron-down"}
            class="size-4"
          />
        </button>
        <button phx-click="show_new_form" class="btn btn-primary btn-sm gap-1">
          <.icon name="hero-plus" class="size-4" />
          <span class="hidden sm:inline">New Condition</span>
          <span class="sm:hidden">New</span>
        </button>
      </:actions>
    </.header>

    <%!-- Search and filter bar --%>
    <div class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-[1fr_12rem_12rem]">
      <%!-- Search box --%>
      <form phx-change="search" phx-submit="search" class="relative sm:col-span-2 lg:col-span-1">
        <input
          type="text"
          name="search"
          value={@search_query}
          placeholder="Search by rule or profile..."
          class="input input-bordered w-full pl-10"
          autocomplete="off"
        />
        <.icon
          name="hero-magnifying-glass"
          class="pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-base-content/50"
        />
      </form>

      <%!-- Status filter --%>
      <form phx-change="filter_status">
        <select name="status" class="select select-bordered w-full">
          <option value="all" selected={@filter_status == "all"}>All statuses</option>
          <option value="enabled" selected={@filter_status == "enabled"}>Enabled</option>
          <option value="disabled" selected={@filter_status == "disabled"}>Disabled</option>
        </select>
      </form>

      <%!-- Profile filter --%>
      <form phx-change="filter_profile">
        <select name="profile" class="select select-bordered w-full">
          <option value="all" selected={@filter_profile == "all"}>All profiles</option>
          <%= for profile_name <- @available_profiles do %>
            <option value={profile_name} selected={@filter_profile == profile_name}>
              {profile_name}
            </option>
          <% end %>
        </select>
      </form>
    </div>

    <%!-- Failed connection list --%>
    <%= if @show_connect_failed do %>
      <div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body p-4 sm:p-6">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
              <h3 class="card-title text-base sm:text-lg">
                <.icon name="hero-exclamation-triangle" class="size-5 text-warning" />
                Hosts that failed to connect
              </h3>
              <%= if length(@connect_failed_hosts) > 0 do %>
                <button
                  phx-click="clear_all_failed"
                  class="btn btn-sm btn-ghost text-error"
                  data-confirm="Clear every failure record?"
                >
                  <.icon name="hero-trash" class="size-4" /> Clear all
                </button>
              <% end %>
            </div>

            <%= if length(@connect_failed_hosts) == 0 do %>
              <div class="text-center py-8 text-base-content/60">
                <.icon
                  name="hero-check-circle"
                  class="size-8 sm:size-12 mx-auto mb-2 text-success"
                />
                <p class="text-sm sm:text-base">No failed connections recorded</p>
              </div>
            <% else %>
              <div class="max-h-96 overflow-auto">
                <table class="table table-pin-rows table-sm hidden md:table">
                  <thead>
                    <tr>
                      <th class="w-80">Pattern</th>
                      <th class="w-48">Profile</th>
                      <th class="w-24">Failures</th>
                      <th class="w-32">Last failure</th>
                      <th class="text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr :for={host <- @connect_failed_hosts} class="hover">
                      <td>
                        <form
                          phx-submit="create_from_failed_form"
                          phx-value-original-host={host.host}
                          phx-value-original-port={host.port}
                          id={"failed-form-#{host.host}-#{host.port}"}
                        >
                          <input
                            type="text"
                            name="pattern"
                            value={"*.#{to_string(host.host)}"}
                            class="input input-bordered input-sm w-full font-mono text-sm"
                            placeholder="*.example.com"
                          />
                        </form>
                      </td>
                      <td>
                        <select
                          name="profile"
                          form={"failed-form-#{host.host}-#{host.port}"}
                          class="select select-bordered select-sm w-full"
                          required
                        >
                          <option value="">Pick a profile</option>
                          <%= for profile_name <- @available_profiles do %>
                            <option value={profile_name}>{profile_name}</option>
                          <% end %>
                        </select>
                      </td>
                      <td>
                        <span class="badge badge-error gap-1">
                          <.icon name="hero-x-circle" class="size-3" />
                          {host.count}
                        </span>
                      </td>
                      <td>
                        <span class="text-xs text-base-content/70">
                          {format_timestamp(host.timestamp)}
                        </span>
                      </td>
                      <td>
                        <div class="flex justify-end gap-2">
                          <%!-- Create rule button --%>
                          <button
                            type="submit"
                            form={"failed-form-#{host.host}-#{host.port}"}
                            class="btn btn-sm btn-primary gap-1"
                            title="Create condition"
                          >
                            <.icon name="hero-plus" class="size-4" /> Create
                          </button>
                          <%!-- Clear record --%>
                          <button
                            phx-click="clear_failed_host"
                            phx-value-host={host.host}
                            phx-value-port={host.port}
                            class="btn btn-sm btn-ghost text-error"
                            title="Clear this record"
                          >
                            <.icon name="hero-trash" class="size-4" />
                          </button>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>

                <%!-- Mobile card view --%>
                <div class="space-y-3 md:hidden">
                  <div :for={host <- @connect_failed_hosts} class="card bg-base-200 p-3">
                    <form
                      phx-submit="create_from_failed_form"
                      phx-value-original-host={host.host}
                      phx-value-original-port={host.port}
                      id={"failed-form-mobile-#{host.host}-#{host.port}"}
                      class="space-y-2"
                    >
                      <div class="flex items-center justify-between gap-2">
                        <p class="break-anywhere text-xs text-base-content/70">
                          {host.count} failures · {format_timestamp(host.timestamp)}
                        </p>
                        <span class="badge badge-error badge-sm shrink-0 gap-1">
                          <.icon name="hero-x-circle" class="size-3" />
                        </span>
                      </div>
                      <input
                        type="text"
                        name="pattern"
                        value={"*.#{to_string(host.host)}"}
                        class="input input-bordered input-sm w-full font-mono"
                        placeholder="*.example.com"
                      />
                      <select
                        name="profile"
                        class="select select-bordered select-sm w-full"
                        required
                      >
                        <option value="">Pick a profile</option>
                        <%= for profile_name <- @available_profiles do %>
                          <option value={profile_name}>{profile_name}</option>
                        <% end %>
                      </select>
                      <div class="flex items-center gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-1 gap-1">
                          <.icon name="hero-plus" class="size-4" /> Create
                        </button>
                        <button
                          type="button"
                          phx-click="clear_failed_host"
                          phx-value-host={host.host}
                          phx-value-port={host.port}
                          class="btn btn-square btn-sm btn-ghost text-error"
                          aria-label="Clear this record"
                        >
                          <.icon name="hero-trash" class="size-4" />
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>

              <div class="mt-4 p-3 sm:p-4 bg-info/10 rounded-lg">
                <div class="flex gap-2">
                  <.icon
                    name="hero-information-circle"
                    class="size-5 text-info flex-shrink-0 mt-0.5"
                  />
                  <div class="text-sm text-base-content/80">
                    <p class="font-semibold mb-1">Tips</p>
                    <ul class="list-disc list-inside space-y-1">
                      <li>The pattern can be edited, and supports the * and ? wildcards</li>
                      <li>Pick the profile to route to, then press "Create"</li>
                      <li>Creating the rule clears the matching failure record</li>
                    </ul>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Condition list, desktop table view --%>
    <div class="hidden md:block card bg-base-100 shadow-xl">
      <div class="card-body p-0">
        <div class="max-h-[calc(100dvh-24rem)] min-h-64 overflow-auto">
          <table class="table table-zebra table-pin-rows table-sm">
            <thead>
              <tr>
                <th class="w-16">ID</th>
                <th class="w-96">Rule</th>
                <th class="w-48">Profile</th>
                <th class="w-24">Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="conditions" phx-update="stream">
              <%!-- New condition form row --%>
              <%= if @show_new_form do %>
                <tr id="new-condition-row" class="bg-base-200">
                  <td class="font-mono text-sm">New</td>
                  <td>
                    <input
                      type="text"
                      name="pattern"
                      form="new-condition-form"
                      class="input input-bordered input-sm w-full font-mono"
                      placeholder="*.example.com"
                      required
                    />
                  </td>
                  <td>
                    <select
                      name="profile_name"
                      form="new-condition-form"
                      class="select select-bordered select-sm w-full"
                      required
                    >
                      <option value="">Pick a profile</option>
                      <%= for profile_name <- @available_profiles do %>
                        <option value={profile_name}>{profile_name}</option>
                      <% end %>
                    </select>
                  </td>
                  <td>
                    <select
                      name="enabled"
                      form="new-condition-form"
                      class="select select-bordered select-sm w-24"
                    >
                      <option value="true" selected>Enabled</option>
                      <option value="false">Disabled</option>
                    </select>
                  </td>
                  <td>
                    <form id="new-condition-form" phx-submit="save_new">
                      <div class="flex justify-end gap-2">
                        <button type="submit" class="btn btn-sm btn-success gap-1" title="Create">
                          <.icon name="hero-check" class="size-4" />
                        </button>
                        <button
                          type="button"
                          phx-click="cancel_new"
                          class="btn btn-sm btn-ghost"
                          title="Cancel"
                        >
                          <.icon name="hero-x-mark" class="size-4" />
                        </button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% end %>

              <tr :if={@conditions_empty? && !@show_new_form} id="empty-state">
                <td colspan="5" class="text-center py-8 text-base-content/60">
                  <%= if @search_query != "" || @filter_status != "all" || @filter_profile != "all" do %>
                    No matching condition
                  <% else %>
                    No conditions yet, create one with the button above
                  <% end %>
                </td>
              </tr>
              <tr :for={{id, condition} <- @streams.conditions} id={id} class="hover">
                <%= if @editing_id == condition.id do %>
                  <%!-- Edit mode --%>
                  <td class="font-mono text-sm">{condition.id}</td>
                  <td>
                    <input
                      type="text"
                      name="pattern"
                      value={format_condition(condition.condition)}
                      form={"edit-form-#{condition.id}"}
                      class="input input-bordered input-sm w-full font-mono"
                      required
                    />
                  </td>
                  <td>
                    <select
                      name="profile_name"
                      form={"edit-form-#{condition.id}"}
                      class="select select-bordered select-sm w-full"
                      required
                    >
                      <%= for profile_name <- @available_profiles do %>
                        <option
                          value={profile_name}
                          selected={condition.profile_name == profile_name}
                        >
                          {profile_name}
                        </option>
                      <% end %>
                    </select>
                  </td>
                  <td>
                    <select
                      name="enabled"
                      form={"edit-form-#{condition.id}"}
                      class="select select-bordered select-sm w-24"
                    >
                      <option value="true" selected={condition.enabled}>Enabled</option>
                      <option value="false" selected={!condition.enabled}>Disabled</option>
                    </select>
                  </td>
                  <td>
                    <form
                      id={"edit-form-#{condition.id}"}
                      phx-submit="save_edit"
                    >
                      <input type="hidden" name="condition_id" value={condition.id} />
                      <div class="flex justify-end gap-2">
                        <button type="submit" class="btn btn-sm btn-success gap-1" title="Save">
                          <.icon name="hero-check" class="size-4" />
                        </button>
                        <button
                          type="button"
                          phx-click="cancel_edit"
                          class="btn btn-sm btn-ghost"
                          title="Cancel"
                        >
                          <.icon name="hero-x-mark" class="size-4" />
                        </button>
                      </div>
                    </form>
                  </td>
                <% else %>
                  <%!-- Read-only mode --%>
                  <td class="font-mono text-sm">{condition.id}</td>
                  <td>
                    <code class="text-sm bg-base-200 px-2 py-1 rounded">
                      {format_condition(condition.condition)}
                    </code>
                  </td>
                  <td>
                    <span class="badge badge-outline badge-lg">
                      {condition.profile_name}
                    </span>
                  </td>
                  <td>
                    <%= if condition.enabled do %>
                      <span class="badge badge-success gap-1 whitespace-nowrap">
                        <.icon name="hero-check-circle" class="size-4" /> Enabled
                      </span>
                    <% else %>
                      <span class="badge badge-ghost gap-1 whitespace-nowrap">
                        <.icon name="hero-x-circle" class="size-4" /> Disabled
                      </span>
                    <% end %>
                  </td>
                  <td>
                    <div class="flex justify-end gap-2">
                      <%!-- Enable/disable toggle --%>
                      <button
                        phx-click="toggle_enable"
                        phx-value-id={condition.id}
                        class="btn btn-sm btn-ghost"
                        title={if condition.enabled, do: "Disable", else: "Enable"}
                      >
                        <%= if condition.enabled do %>
                          <.icon name="hero-pause" class="size-4" />
                        <% else %>
                          <.icon name="hero-play" class="size-4" />
                        <% end %>
                      </button>

                      <%!-- Edit --%>
                      <button
                        phx-click="start_edit"
                        phx-value-id={condition.id}
                        class="btn btn-sm btn-ghost"
                        title="Edit"
                      >
                        <.icon name="hero-pencil" class="size-4" />
                      </button>

                      <%!-- Delete --%>
                      <button
                        phx-click="delete_confirm"
                        phx-value-id={condition.id}
                        class="btn btn-sm btn-ghost text-error hover:bg-error/10"
                        title="Delete"
                      >
                        <.icon name="hero-trash" class="size-4" />
                      </button>
                    </div>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%!-- Condition list, mobile card view. Rendered from @conditions rather than
         a second `phx-update="stream"` container — see load_conditions/1. --%>
    <div class="space-y-3 md:hidden">
      <%!-- New condition form card --%>
      <div :if={@show_new_form} class="card border border-primary/40 bg-base-100 shadow-lg">
        <div class="card-body p-4">
          <h3 class="card-title mb-3 text-base">New Condition</h3>
          <form id="new-condition-form-mobile" phx-submit="save_new" class="space-y-3">
            <div>
              <label class="label label-text text-xs" for="new-condition-pattern">Rule</label>
              <input
                id="new-condition-pattern"
                type="text"
                name="pattern"
                class="input input-bordered input-sm w-full font-mono"
                placeholder="*.example.com"
                required
              />
            </div>
            <div>
              <label class="label label-text text-xs" for="new-condition-profile">Profile</label>
              <select
                id="new-condition-profile"
                name="profile_name"
                class="select select-bordered select-sm w-full"
                required
              >
                <option value="">Pick a profile</option>
                <option :for={profile_name <- @available_profiles} value={profile_name}>
                  {profile_name}
                </option>
              </select>
            </div>
            <div>
              <label class="label label-text text-xs" for="new-condition-enabled">Status</label>
              <select
                id="new-condition-enabled"
                name="enabled"
                class="select select-bordered select-sm w-full"
              >
                <option value="true" selected>Enabled</option>
                <option value="false">Disabled</option>
              </select>
            </div>
            <div class="flex gap-2 pt-2">
              <button type="submit" class="btn btn-success btn-sm flex-1 gap-1">
                <.icon name="hero-check" class="size-4" /> Create
              </button>
              <button type="button" phx-click="cancel_new" class="btn btn-ghost btn-sm flex-1">
                Cancel
              </button>
            </div>
          </form>
        </div>
      </div>

      <%!-- Empty state --%>
      <div :if={@conditions_empty? && !@show_new_form} class="card bg-base-100 shadow-lg">
        <div class="card-body py-12 text-center">
          <p class="text-base-content/60">
            <%= if @search_query != "" || @filter_status != "all" || @filter_profile != "all" do %>
              No matching condition
            <% else %>
              No conditions yet, create one with the button above
            <% end %>
          </p>
        </div>
      </div>

      <%!-- Condition cards --%>
      <div id="conditions-mobile" class="space-y-3">
        <div
          :for={condition <- @conditions}
          id={"condition-#{condition.id}-mobile"}
          class="card bg-base-100 shadow-lg"
        >
          <div class="card-body p-4">
            <%= if @editing_id == condition.id do %>
              <%!-- Edit mode --%>
              <form
                id={"edit-form-mobile-#{condition.id}"}
                phx-submit="save_edit"
                class="space-y-3"
              >
                <input type="hidden" name="condition_id" value={condition.id} />
                <div>
                  <label class="label label-text text-xs">Rule</label>
                  <input
                    type="text"
                    name="pattern"
                    value={format_condition(condition.condition)}
                    class="input input-bordered input-sm w-full font-mono"
                    required
                  />
                </div>
                <div>
                  <label class="label label-text text-xs">Profile</label>
                  <select
                    name="profile_name"
                    class="select select-bordered select-sm w-full"
                    required
                  >
                    <option
                      :for={profile_name <- @available_profiles}
                      value={profile_name}
                      selected={condition.profile_name == profile_name}
                    >
                      {profile_name}
                    </option>
                  </select>
                </div>
                <div>
                  <label class="label label-text text-xs">Status</label>
                  <select name="enabled" class="select select-bordered select-sm w-full">
                    <option value="true" selected={condition.enabled}>Enabled</option>
                    <option value="false" selected={!condition.enabled}>Disabled</option>
                  </select>
                </div>
                <div class="flex gap-2 pt-2">
                  <button type="submit" class="btn btn-success btn-sm flex-1 gap-1">
                    <.icon name="hero-check" class="size-4" /> Save
                  </button>
                  <button
                    type="button"
                    phx-click="cancel_edit"
                    class="btn btn-ghost btn-sm flex-1"
                  >
                    Cancel
                  </button>
                </div>
              </form>
            <% else %>
              <%!-- Read-only mode --%>
              <div class="mb-3">
                <div class="flex items-start justify-between gap-2">
                  <code class="break-anywhere rounded bg-base-200 px-2 py-1 text-sm">
                    {format_condition(condition.condition)}
                  </code>
                  <span class="shrink-0 font-mono text-xs text-base-content/50">
                    #{condition.id}
                  </span>
                </div>
                <div class="mt-2 flex flex-wrap gap-2">
                  <span class="badge badge-outline badge-sm">{condition.profile_name}</span>
                  <%= if condition.enabled do %>
                    <span class="badge badge-success badge-sm gap-1">
                      <.icon name="hero-check-circle" class="size-3" /> Enabled
                    </span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm gap-1">
                      <.icon name="hero-x-circle" class="size-3" /> Disabled
                    </span>
                  <% end %>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <button
                  phx-click="toggle_enable"
                  phx-value-id={condition.id}
                  class="btn btn-sm btn-ghost min-w-28 flex-1"
                >
                  <%= if condition.enabled do %>
                    <.icon name="hero-pause" class="size-4" /> Disable
                  <% else %>
                    <.icon name="hero-play" class="size-4" /> Enable
                  <% end %>
                </button>
                <button
                  phx-click="start_edit"
                  phx-value-id={condition.id}
                  class="btn btn-square btn-sm btn-ghost"
                  aria-label="Edit"
                >
                  <.icon name="hero-pencil" class="size-4" />
                </button>
                <button
                  phx-click="delete_confirm"
                  phx-value-id={condition.id}
                  class="btn btn-square btn-sm btn-ghost text-error"
                  aria-label="Delete"
                >
                  <.icon name="hero-trash" class="size-4" />
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%!-- Delete confirmation dialog --%>
    <%= if @delete_id do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <h3 class="font-bold text-lg mb-4">Confirm deletion</h3>
          <p class="py-4">
            Delete condition <span class="font-bold">#{@delete_id}</span>?
          </p>
          <p class="text-sm text-warning">
            <.icon name="hero-exclamation-triangle" class="size-4 inline" />
            This removes the routing rule.
          </p>
          <div class="modal-action">
            <button
              phx-click="delete_cancel"
              class="btn btn-ghost"
            >
              Cancel
            </button>
            <button
              phx-click="delete"
              phx-value-id={@delete_id}
              class="btn btn-error"
            >
              Delete
            </button>
          </div>
        </div>
        <label class="modal-backdrop" phx-click="delete_cancel">Close</label>
      </div>
    <% end %>
  </div>
</Layouts.app>
