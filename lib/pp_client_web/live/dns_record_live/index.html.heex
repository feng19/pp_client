<Layouts.app flash={@flash}>
  <div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <.header>
      DNS Records
      <:subtitle>
        Domain to IP overrides used when dialling an upstream server
      </:subtitle>
      <:actions>
        <.button phx-click="new" class="btn-sm">
          <.icon name="hero-plus" class="size-4 sm:size-5" />
          <span class="hidden sm:inline ml-1">New Record</span>
          <span class="sm:hidden">New</span>
        </.button>
      </:actions>
    </.header>

    <div class="alert alert-info alert-soft mt-4 text-sm">
      <.icon name="hero-information-circle" class="size-5" />
      <span>
        A server whose hostname has an enabled record here is dialled by IP, with the
        domain still carried in the TLS SNI and the <code>Host</code>
        header. Everything else is resolved by the system as usual — nothing is looked
        up automatically. Records added here live in memory only; keep them past a
        restart by downloading a <code>pp.exs</code>
        from the <.link navigate={~p"/admin/config"} class="link link-primary">Config</.link>
        page.
      </span>
    </div>

    <%!-- Search bar --%>
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 my-4 sm:my-6">
      <div class="flex-1">
        <form phx-change="search" phx-submit="search" class="relative">
          <input
            type="text"
            name="search"
            value={@search_query}
            placeholder="Search by domain or IP..."
            class="input input-bordered input-sm sm:input-md w-full pl-9 sm:pl-10"
            autocomplete="off"
          />
          <.icon
            name="hero-magnifying-glass"
            class="absolute left-2.5 sm:left-3 top-1/2 -translate-y-1/2 size-4 sm:size-5 text-base-content/50"
          />
        </form>
      </div>
    </div>

    <%!-- Record list, desktop table view --%>
    <div class="hidden md:block card bg-base-100 shadow-xl">
      <div class="card-body p-0">
        <div class="overflow-x-auto max-h-[calc(100vh-20rem)] overflow-y-auto">
          <table class="table table-zebra table-sm">
            <thead>
              <tr>
                <th class="w-64">Domain</th>
                <th class="w-48">IP</th>
                <th class="w-24">Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="dns-records" phx-update="stream">
              <tr :if={@records_empty?} id="empty-state">
                <td colspan="4" class="text-center py-8 text-base-content/60">
                  <%= if @search_query != "" do %>
                    No matching DNS record
                  <% else %>
                    No DNS records yet, create one with the button above
                  <% end %>
                </td>
              </tr>
              <tr :for={{id, record} <- @streams.dns_records} id={id} class="hover">
                <td class="font-semibold">{record.domain}</td>
                <td class="font-mono">{format_ip(record)}</td>
                <td>
                  <%= if record.enable do %>
                    <span class="badge badge-success gap-1 whitespace-nowrap">
                      <.icon name="hero-check-circle" class="size-4" /> Enabled
                    </span>
                  <% else %>
                    <span class="badge badge-ghost gap-1 whitespace-nowrap">
                      <.icon name="hero-x-circle" class="size-4" /> Disabled
                    </span>
                  <% end %>
                </td>
                <td>
                  <div class="flex justify-end gap-2">
                    <%!-- Enable/disable toggle --%>
                    <button
                      phx-click="toggle_enable"
                      phx-value-domain={record.domain}
                      class="btn btn-sm btn-ghost"
                      title={if record.enable, do: "Disable", else: "Enable"}
                    >
                      <%= if record.enable do %>
                        <.icon name="hero-pause" class="size-4" />
                      <% else %>
                        <.icon name="hero-play" class="size-4" />
                      <% end %>
                    </button>

                    <%!-- Edit --%>
                    <button
                      phx-click="edit"
                      phx-value-domain={record.domain}
                      class="btn btn-sm btn-ghost"
                      title="Edit"
                    >
                      <.icon name="hero-pencil" class="size-4" />
                    </button>

                    <%!-- Delete --%>
                    <button
                      phx-click="delete_confirm"
                      phx-value-domain={record.domain}
                      class="btn btn-sm btn-ghost text-error hover:bg-error/10"
                      title="Delete"
                    >
                      <.icon name="hero-trash" class="size-4" />
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%!-- Record list, mobile card view --%>
    <div class="md:hidden space-y-3">
      <%= if @records_empty? do %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body text-center py-12">
            <p class="text-base-content/60">
              <%= if @search_query != "" do %>
                No matching DNS record
              <% else %>
                No DNS records yet, create one with the button above
              <% end %>
            </p>
          </div>
        </div>
      <% end %>

      <div id="dns-records-mobile" class="space-y-3">
        <div
          :for={record <- @records}
          id={"dns-#{record.domain}-mobile"}
          class="card bg-base-100 shadow-lg"
        >
          <div class="card-body p-4">
            <div class="flex justify-between items-start mb-3">
              <div class="flex-1">
                <h3 class="font-bold text-base break-all">{record.domain}</h3>
                <div class="flex gap-2 mt-2 flex-wrap items-center">
                  <span class="badge badge-outline badge-sm font-mono">{format_ip(record)}</span>
                  <%= if record.enable do %>
                    <span class="badge badge-success badge-sm gap-1">
                      <.icon name="hero-check-circle" class="size-3" /> Enabled
                    </span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm gap-1">
                      <.icon name="hero-x-circle" class="size-3" /> Disabled
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="flex gap-2 flex-wrap">
              <button
                phx-click="toggle_enable"
                phx-value-domain={record.domain}
                class="btn btn-sm btn-ghost flex-1"
                title={if record.enable, do: "Disable", else: "Enable"}
              >
                <%= if record.enable do %>
                  <.icon name="hero-pause" class="size-4" /> Disable
                <% else %>
                  <.icon name="hero-play" class="size-4" /> Enable
                <% end %>
              </button>
              <button
                phx-click="edit"
                phx-value-domain={record.domain}
                class="btn btn-sm btn-ghost"
              >
                <.icon name="hero-pencil" class="size-4" /> Edit
              </button>
              <button
                phx-click="delete_confirm"
                phx-value-domain={record.domain}
                class="btn btn-sm btn-ghost text-error"
                title="Delete"
              >
                <.icon name="hero-trash" class="size-4" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Form modal --%>
    <%= if @form do %>
      <div class="modal modal-open">
        <div class="modal-box max-h-[90vh] overflow-y-auto">
          <h3 class="font-bold text-lg mb-4">
            {if @editing_domain, do: "Edit DNS Record", else: "New DNS Record"}
          </h3>

          <.form for={@form} id="dns-record-form" phx-change="validate" phx-submit="save">
            <.input
              field={@form[:domain]}
              type="text"
              label="Domain"
              placeholder="server.example.com"
              autocomplete="off"
              required
            />

            <.input
              field={@form[:ip]}
              type="text"
              label="IP address"
              placeholder="203.0.113.10"
              autocomplete="off"
              required
            />

            <.input field={@form[:enable]} type="checkbox" label="Enabled" />

            <div class="modal-action">
              <.button type="button" phx-click="cancel" class="btn btn-ghost">
                Cancel
              </.button>
              <.button type="submit" variant="primary">
                Save
              </.button>
            </div>
          </.form>
        </div>
        <label class="modal-backdrop" phx-click="cancel">Close</label>
      </div>
    <% end %>

    <%!-- Delete confirmation dialog --%>
    <%= if @delete_domain do %>
      <div id="delete-dialog" class="modal modal-open">
        <div class="modal-box">
          <h3 class="font-bold text-lg mb-4">Confirm deletion</h3>
          <p class="py-4">
            Delete the DNS record for <span class="font-bold">{@delete_domain}</span>?
          </p>
          <p class="text-sm text-warning">
            <.icon name="hero-exclamation-triangle" class="size-4 inline" />
            Connections to that domain go back to the system resolver.
          </p>
          <div class="modal-action">
            <button phx-click="delete_cancel" class="btn btn-ghost">
              Cancel
            </button>
            <button
              phx-click="delete"
              phx-value-domain={@delete_domain}
              class="btn btn-error"
            >
              Delete
            </button>
          </div>
        </div>
        <label class="modal-backdrop" phx-click="delete_cancel">Close</label>
      </div>
    <% end %>
  </div>
</Layouts.app>
