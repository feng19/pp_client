<Layouts.app flash={@flash}>
  <div class="space-y-4 sm:space-y-6">
    <.header>
      Profiles
      <:subtitle>Manage the proxy profiles</:subtitle>
      <:actions>
        <.button navigate={~p"/admin/profiles/new"} class="btn btn-primary btn-sm gap-1">
          <.icon name="hero-plus" class="size-4" />
          <span class="hidden sm:inline">New Profile</span>
          <span class="sm:hidden">New</span>
        </.button>
      </:actions>
    </.header>

    <%!-- Search bar --%>
    <form phx-change="search" phx-submit="search" class="relative">
      <input
        type="text"
        name="search"
        value={@search_query}
        placeholder="Search by profile name or type..."
        class="input input-bordered w-full pl-10"
        autocomplete="off"
      />
      <.icon
        name="hero-magnifying-glass"
        class="pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-base-content/50"
      />
    </form>

    <%!-- Profile list, desktop table view --%>
    <div class="hidden md:block card bg-base-100 shadow-xl">
      <div class="card-body p-0">
        <div class="max-h-[calc(100dvh-22rem)] min-h-64 overflow-auto">
          <table class="table table-zebra table-pin-rows table-sm">
            <thead>
              <tr>
                <th class="w-48">Name</th>
                <th class="w-32">Type</th>
                <th class="w-24">Servers</th>
                <th class="w-24">Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="profiles" phx-update="stream">
              <tr :if={@profiles_empty?} id="empty-state">
                <td colspan="5" class="text-center py-8 text-base-content/60">
                  <%= if @search_query != "" do %>
                    No matching profile
                  <% else %>
                    No profiles yet, create one with the button above
                  <% end %>
                </td>
              </tr>
              <tr :for={{id, profile} <- @streams.profiles} id={id} class="hover">
                <td class="font-semibold">{profile.name}</td>
                <td>
                  <span class="badge badge-outline">{type_label(profile.type)}</span>
                </td>
                <td>
                  <%= if profile.type == :direct or profile.servers in [nil, []] do %>
                    <span class="text-base-content/50">-</span>
                  <% else %>
                    <div class="flex gap-1 flex-wrap">
                      <span :for={name <- profile.servers} class="badge badge-ghost">
                        {name}
                      </span>
                    </div>
                  <% end %>
                </td>
                <td>
                  <%= if profile.enabled do %>
                    <span class="badge badge-success gap-1 whitespace-nowrap">
                      <.icon name="hero-check-circle" class="size-4" /> Enabled
                    </span>
                  <% else %>
                    <span class="badge badge-ghost gap-1 whitespace-nowrap">
                      <.icon name="hero-x-circle" class="size-4" /> Disabled
                    </span>
                  <% end %>
                </td>
                <td>
                  <div class="flex justify-end gap-2">
                    <%!-- Enable/disable toggle --%>
                    <button
                      phx-click="toggle_enable"
                      phx-value-name={profile.name}
                      class="btn btn-sm btn-ghost"
                      title={if profile.enabled, do: "Disable", else: "Enable"}
                    >
                      <%= if profile.enabled do %>
                        <.icon name="hero-pause" class="size-4" />
                      <% else %>
                        <.icon name="hero-play" class="size-4" />
                      <% end %>
                    </button>

                    <%!-- Edit --%>
                    <.button
                      navigate={~p"/admin/profiles/#{profile.name}/edit"}
                      class="btn btn-sm btn-ghost"
                    >
                      <.icon name="hero-pencil" class="size-4" />
                    </.button>

                    <%!-- Delete --%>
                    <button
                      phx-click="delete_confirm"
                      phx-value-name={profile.name}
                      class="btn btn-sm btn-ghost text-error hover:bg-error/10"
                      title="Delete"
                    >
                      <.icon name="hero-trash" class="size-4" />
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%!-- Profile list, mobile card view --%>
    <div class="md:hidden space-y-3">
      <%!-- Empty state --%>
      <%= if @profiles_empty? do %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body text-center py-12">
            <p class="text-base-content/60">
              <%= if @search_query != "" do %>
                No matching profile
              <% else %>
                No profiles yet, create one with the button above
              <% end %>
            </p>
          </div>
        </div>
      <% end %>

      <%!-- Profile cards. Rendered from @profiles rather than a second
           `phx-update="stream"` container — see the comment on load_profiles/1. --%>
      <div id="profiles-mobile" class="space-y-3">
        <div
          :for={profile <- @profiles}
          id={"profile-#{profile.name}-mobile"}
          class="card bg-base-100 shadow-lg"
        >
          <div class="card-body p-4">
            <div class="mb-3">
              <div class="min-w-0">
                <h3 class="break-anywhere text-base font-bold">{profile.name}</h3>
                <div class="mt-2 flex flex-wrap gap-2">
                  <span class="badge badge-outline badge-sm">{type_label(profile.type)}</span>
                  <%= if profile.enabled do %>
                    <span class="badge badge-success badge-sm gap-1">
                      <.icon name="hero-check-circle" class="size-3" /> Enabled
                    </span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm gap-1">
                      <.icon name="hero-x-circle" class="size-3" /> Disabled
                    </span>
                  <% end %>
                  <%= if profile.type != :direct do %>
                    <span :for={name <- profile.servers || []} class="badge badge-ghost badge-sm">
                      {name}
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button
                phx-click="toggle_enable"
                phx-value-name={profile.name}
                class="btn btn-sm btn-ghost min-w-28 flex-1"
              >
                <%= if profile.enabled do %>
                  <.icon name="hero-pause" class="size-4" /> Disable
                <% else %>
                  <.icon name="hero-play" class="size-4" /> Enable
                <% end %>
              </button>
              <.button
                navigate={~p"/admin/profiles/#{profile.name}/edit"}
                class="btn btn-square btn-sm btn-ghost"
                aria-label="Edit"
              >
                <.icon name="hero-pencil" class="size-4" />
              </.button>
              <button
                phx-click="delete_confirm"
                phx-value-name={profile.name}
                class="btn btn-square btn-sm btn-ghost text-error"
                aria-label="Delete"
              >
                <.icon name="hero-trash" class="size-4" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Form modal --%>
    <%= if @live_action in [:new, :edit] do %>
      <div class="modal modal-open">
        <div class="modal-box max-h-[85dvh] max-w-2xl overflow-y-auto">
          <h3 class="mb-4 text-lg font-bold">
            {if @live_action == :new, do: "New Profile", else: "Edit Profile"}
          </h3>

          <.form
            for={@form}
            id="profile-form"
            phx-change="validate"
            phx-submit="save"
          >
            <.input
              field={@form[:name]}
              type="text"
              label="Name"
              placeholder="my-profile"
              required
            />

            <.input
              field={@form[:type]}
              type="select"
              label="Type"
              options={[
                {"Direct", :direct},
                {"Remote proxy", :remote}
              ]}
              required
            />

            <.input
              field={@form[:enabled]}
              type="checkbox"
              label="Enabled"
            />

            <%!-- Server selection, remote profiles only --%>
            <%= if @form[:type].value in [:remote, "remote"] do %>
              <div class="divider">Servers</div>

              <%= if @servers == [] do %>
                <div class="alert alert-warning">
                  <.icon name="hero-exclamation-triangle" class="size-5" />
                  <span>
                    No servers defined yet. <.link navigate={~p"/admin/servers"} class="link">Add one first</.link>.
                  </span>
                </div>
              <% else %>
                <%!-- The blank entry keeps the servers key in the params even when
                     nothing is selected, so clearing the picker really clears the
                     list instead of leaving the stored one in place. It is dropped
                     in ProfileSchema.changeset/2. --%>
                <input type="hidden" name="profile_schema[servers][]" value="" />
                <.input
                  field={@form[:servers]}
                  type="select"
                  multiple
                  label="Servers"
                  class="w-full select h-40"
                  options={Enum.map(@servers, &server_option/1)}
                />
                <p class="text-xs text-base-content/60 -mt-1 mb-2">
                  One is picked at random per connection, which doubles as failover.
                  Manage them on the
                  <.link navigate={~p"/admin/servers"} class="link">Servers</.link>
                  page.
                </p>
              <% end %>
            <% end %>

            <div class="modal-action">
              <.button
                type="button"
                navigate={~p"/admin/profiles"}
                class="btn btn-ghost"
              >
                Cancel
              </.button>
              <.button type="submit" variant="primary">
                Save
              </.button>
            </div>
          </.form>
        </div>
        <label class="modal-backdrop" phx-click={JS.navigate(~p"/admin/profiles")}>
          Close
        </label>
      </div>
    <% end %>

    <%!-- Delete confirmation dialog --%>
    <%= if @delete_name do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <h3 class="font-bold text-lg mb-4">Confirm deletion</h3>
          <p class="py-4">
            Delete the profile <span class="font-bold">{@delete_name}</span>?
          </p>
          <p class="text-sm text-warning">
            <.icon name="hero-exclamation-triangle" class="size-4 inline" />
            This removes the profile.
          </p>
          <div class="modal-action">
            <button
              phx-click="delete_cancel"
              class="btn btn-ghost"
            >
              Cancel
            </button>
            <button
              phx-click="delete"
              phx-value-name={@delete_name}
              class="btn btn-error"
            >
              Delete
            </button>
          </div>
        </div>
        <label class="modal-backdrop" phx-click="delete_cancel">Close</label>
      </div>
    <% end %>
  </div>
</Layouts.app>
