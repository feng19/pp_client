<Layouts.app flash={@flash}>
  <div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <.header>
      Profiles
      <:subtitle>Manage the proxy profiles</:subtitle>
      <:actions>
        <.button navigate={~p"/admin/profiles/new"} class="btn-sm">
          <.icon name="hero-plus" class="size-4 sm:size-5" />
          <span class="hidden sm:inline ml-1">New Profile</span>
          <span class="sm:hidden">New</span>
        </.button>
      </:actions>
    </.header>

    <%!-- Search bar --%>
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 my-4 sm:my-6">
      <%!-- Search box --%>
      <div class="flex-1">
        <form phx-change="search" phx-submit="search" class="relative">
          <input
            type="text"
            name="search"
            value={@search_query}
            placeholder="Search by profile name or type..."
            class="input input-bordered input-sm sm:input-md w-full pl-9 sm:pl-10"
            autocomplete="off"
          />
          <.icon
            name="hero-magnifying-glass"
            class="absolute left-2.5 sm:left-3 top-1/2 -translate-y-1/2 size-4 sm:size-5 text-base-content/50"
          />
        </form>
      </div>
    </div>

    <%!-- Profile list, desktop table view --%>
    <div class="hidden md:block card bg-base-100 shadow-xl">
      <div class="card-body p-0">
        <div class="overflow-x-auto max-h-[calc(100vh-20rem)] overflow-y-auto">
          <table class="table table-zebra table-sm">
            <thead>
              <tr>
                <th class="w-48">Name</th>
                <th class="w-32">Type</th>
                <th class="w-24">Servers</th>
                <th class="w-24">Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="profiles" phx-update="stream">
              <tr :if={@profiles_empty?} id="empty-state">
                <td colspan="5" class="text-center py-8 text-base-content/60">
                  <%= if @search_query != "" do %>
                    No matching profile
                  <% else %>
                    No profiles yet, create one with the button above
                  <% end %>
                </td>
              </tr>
              <tr :for={{id, profile} <- @streams.profiles} id={id} class="hover">
                <td class="font-semibold">{profile.name}</td>
                <td>
                  <span class="badge badge-outline">{type_label(profile.type)}</span>
                </td>
                <td>
                  <%= if profile.type == :direct do %>
                    <span class="text-base-content/50">-</span>
                  <% else %>
                    <span class="badge badge-ghost">
                      {length(profile.servers || [])}
                    </span>
                  <% end %>
                </td>
                <td>
                  <%= if profile.enabled do %>
                    <span class="badge badge-success gap-1 whitespace-nowrap">
                      <.icon name="hero-check-circle" class="size-4" /> Enabled
                    </span>
                  <% else %>
                    <span class="badge badge-ghost gap-1 whitespace-nowrap">
                      <.icon name="hero-x-circle" class="size-4" /> Disabled
                    </span>
                  <% end %>
                </td>
                <td>
                  <div class="flex justify-end gap-2">
                    <%!-- Enable/disable toggle --%>
                    <button
                      phx-click="toggle_enable"
                      phx-value-name={profile.name}
                      class="btn btn-sm btn-ghost"
                      title={if profile.enabled, do: "Disable", else: "Enable"}
                    >
                      <%= if profile.enabled do %>
                        <.icon name="hero-pause" class="size-4" />
                      <% else %>
                        <.icon name="hero-play" class="size-4" />
                      <% end %>
                    </button>

                    <%!-- Edit --%>
                    <.button
                      navigate={~p"/admin/profiles/#{profile.name}/edit"}
                      class="btn btn-sm btn-ghost"
                    >
                      <.icon name="hero-pencil" class="size-4" />
                    </.button>

                    <%!-- Delete --%>
                    <button
                      phx-click="delete_confirm"
                      phx-value-name={profile.name}
                      class="btn btn-sm btn-ghost text-error hover:bg-error/10"
                      title="Delete"
                    >
                      <.icon name="hero-trash" class="size-4" />
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%!-- Profile list, mobile card view --%>
    <div class="md:hidden space-y-3">
      <%!-- Empty state --%>
      <%= if @profiles_empty? do %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body text-center py-12">
            <p class="text-base-content/60">
              <%= if @search_query != "" do %>
                No matching profile
              <% else %>
                No profiles yet, create one with the button above
              <% end %>
            </p>
          </div>
        </div>
      <% end %>

      <%!-- Profile cards --%>
      <div id="profiles-mobile" phx-update="stream">
        <div
          :for={{id, profile} <- @streams.profiles}
          id={"#{id}-mobile"}
          class="card bg-base-100 shadow-lg"
        >
          <div class="card-body p-4">
            <div class="flex justify-between items-start mb-3">
              <div class="flex-1">
                <h3 class="font-bold text-base">{profile.name}</h3>
                <div class="flex gap-2 mt-2 flex-wrap">
                  <span class="badge badge-outline badge-sm">{type_label(profile.type)}</span>
                  <%= if profile.enabled do %>
                    <span class="badge badge-success badge-sm gap-1">
                      <.icon name="hero-check-circle" class="size-3" /> Enabled
                    </span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm gap-1">
                      <.icon name="hero-x-circle" class="size-3" /> Disabled
                    </span>
                  <% end %>
                  <%= if profile.type != :direct do %>
                    <span class="badge badge-ghost badge-sm">
                      {length(profile.servers || [])} servers
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="flex gap-2 flex-wrap">
              <button
                phx-click="toggle_enable"
                phx-value-name={profile.name}
                class="btn btn-sm btn-ghost flex-1"
                title={if profile.enabled, do: "Disable", else: "Enable"}
              >
                <%= if profile.enabled do %>
                  <.icon name="hero-pause" class="size-4" /> Disable
                <% else %>
                  <.icon name="hero-play" class="size-4" /> Enable
                <% end %>
              </button>
              <.button
                navigate={~p"/admin/profiles/#{profile.name}/edit"}
                class="btn btn-sm btn-ghost"
              >
                <.icon name="hero-pencil" class="size-4" /> Edit
              </.button>
              <button
                phx-click="delete_confirm"
                phx-value-name={profile.name}
                class="btn btn-sm btn-ghost text-error"
                title="Delete"
              >
                <.icon name="hero-trash" class="size-4" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Form modal --%>
    <%= if @live_action in [:new, :edit] do %>
      <div class="modal modal-open">
        <div class="modal-box max-w-4xl max-h-[90vh] overflow-y-auto">
          <h3 class="font-bold text-lg mb-4">
            {if @live_action == :new, do: "New Profile", else: "Edit Profile"}
          </h3>

          <.form
            for={@form}
            id="profile-form"
            phx-change="validate"
            phx-submit="save"
          >
            <.input
              field={@form[:name]}
              type="text"
              label="Name"
              placeholder="my-profile"
              required
            />

            <.input
              field={@form[:type]}
              type="select"
              label="Type"
              options={[
                {"Direct", :direct},
                {"Remote proxy", :remote}
              ]}
              required
            />

            <.input
              field={@form[:enabled]}
              type="checkbox"
              label="Enabled"
            />

            <%!-- Server configuration, remote profiles only --%>
            <%= if @form[:type].value == :remote || @form[:type].value == "remote" do %>
              <div class="divider">Servers</div>

              <%!-- Server validation errors --%>
              <%= if @form.errors[:servers] do %>
                <div class="alert alert-error">
                  <.icon name="hero-exclamation-circle" class="size-5" />
                  <span>{elem(@form.errors[:servers], 0)}</span>
                </div>
              <% end %>

              <div class="space-y-4">
                <%= for {index, server_data} <- @server_forms do %>
                  <div class="card bg-base-200 p-4">
                    <div class="flex justify-between items-center mb-3">
                      <h4 class="font-semibold">Server #{index + 1}</h4>
                      <button
                        type="button"
                        phx-click="remove_server"
                        phx-value-index={index}
                        class="btn btn-sm btn-ghost btn-circle text-error"
                      >
                        <.icon name="hero-x-mark" class="size-5" />
                      </button>
                    </div>

                    <input
                      type="hidden"
                      name={"profile_schema[servers][#{index}][_index]"}
                      value={index}
                    />

                    <.input
                      name={"profile_schema[servers][#{index}][type]"}
                      id={"profile_schema_servers_#{index}_type"}
                      value={server_data["type"]}
                      type="select"
                      label="Server type"
                      options={[
                        {"EXPS", "exps"},
                        {"CF Workers", "cf-workers"},
                        {"SOCKS5", "socks5"}
                      ]}
                      required
                    />

                    <.input
                      name={"profile_schema[servers][#{index}][enable]"}
                      id={"profile_schema_servers_#{index}_enable"}
                      value={server_data["enable"]}
                      type="checkbox"
                      label="Enable this server"
                    />

                    <%!-- EXPS fields --%>
                    <%= if server_data["type"] == "exps" do %>
                      <.input
                        name={"profile_schema[servers][#{index}][uri]"}
                        id={"profile_schema_servers_#{index}_uri"}
                        value={server_data["uri"]}
                        type="text"
                        label="WebSocket URI"
                        placeholder="wss://example.com/ws"
                        required
                      />

                      <.input
                        name={"profile_schema[servers][#{index}][encrypt_type]"}
                        id={"profile_schema_servers_#{index}_encrypt_type"}
                        value={server_data["encrypt_type"] || "none"}
                        type="select"
                        label="Encryption"
                        options={[
                          {"None", "none"},
                          {"Once", "once"}
                        ]}
                      />

                      <.input
                        name={"profile_schema[servers][#{index}][encrypt_key]"}
                        id={"profile_schema_servers_#{index}_encrypt_key"}
                        value={server_data["encrypt_key"]}
                        type="text"
                        label="Encryption key (optional)"
                        placeholder="encryption-key"
                      />
                    <% end %>

                    <%!-- CF Workers fields --%>
                    <%= if server_data["type"] == "cf-workers" do %>
                      <.input
                        name={"profile_schema[servers][#{index}][uri]"}
                        id={"profile_schema_servers_#{index}_uri"}
                        value={server_data["uri"]}
                        type="text"
                        label="WebSocket URI"
                        placeholder="wss://worker.example.com"
                        required
                      />

                      <.input
                        name={"profile_schema[servers][#{index}][password]"}
                        id={"profile_schema_servers_#{index}_password"}
                        value={server_data["password"]}
                        type="password"
                        label="Password"
                        placeholder="password"
                        required
                      />
                    <% end %>

                    <%!-- SOCKS5 fields --%>
                    <%= if server_data["type"] == "socks5" do %>
                      <.input
                        name={"profile_schema[servers][#{index}][host]"}
                        id={"profile_schema_servers_#{index}_host"}
                        value={server_data["host"]}
                        type="text"
                        label="Host"
                        placeholder="127.0.0.1"
                        required
                      />

                      <.input
                        name={"profile_schema[servers][#{index}][port]"}
                        id={"profile_schema_servers_#{index}_port"}
                        value={server_data["port"]}
                        type="number"
                        label="Port"
                        placeholder="1080"
                        required
                      />
                    <% end %>
                  </div>
                <% end %>

                <button
                  type="button"
                  phx-click="add_server"
                  class="btn btn-outline btn-block"
                >
                  <.icon name="hero-plus" class="size-5" /> Add server
                </button>
              </div>
            <% end %>

            <div class="modal-action">
              <.button
                type="button"
                navigate={~p"/admin/profiles"}
                class="btn btn-ghost"
              >
                Cancel
              </.button>
              <.button type="submit" variant="primary">
                Save
              </.button>
            </div>
          </.form>
        </div>
        <label class="modal-backdrop" phx-click={JS.navigate(~p"/admin/profiles")}>
          Close
        </label>
      </div>
    <% end %>

    <%!-- Delete confirmation dialog --%>
    <%= if @delete_name do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <h3 class="font-bold text-lg mb-4">Confirm deletion</h3>
          <p class="py-4">
            Delete the profile <span class="font-bold">{@delete_name}</span>?
          </p>
          <p class="text-sm text-warning">
            <.icon name="hero-exclamation-triangle" class="size-4 inline" />
            This removes the profile.
          </p>
          <div class="modal-action">
            <button
              phx-click="delete_cancel"
              class="btn btn-ghost"
            >
              Cancel
            </button>
            <button
              phx-click="delete"
              phx-value-name={@delete_name}
              class="btn btn-error"
            >
              Delete
            </button>
          </div>
        </div>
        <label class="modal-backdrop" phx-click="delete_cancel">Close</label>
      </div>
    <% end %>
  </div>
</Layouts.app>
