<Layouts.app flash={@flash}>
  <div class="space-y-4 sm:space-y-6">
    <.header>
      Endpoints
      <:subtitle>Manage the local proxy listeners</:subtitle>
      <:actions>
        <button phx-click="show_new_form" class="btn btn-primary btn-sm gap-1">
          <.icon name="hero-plus" class="size-4" />
          <span class="hidden sm:inline">New Endpoint</span>
          <span class="sm:hidden">New</span>
        </button>
      </:actions>
    </.header>

    <%!-- Search and filter bar --%>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
      <%!-- Search box --%>
      <div class="min-w-0 flex-1">
        <form phx-change="search" phx-submit="search" class="relative">
          <input
            type="text"
            name="search"
            value={@search_query}
            placeholder="Search by port or type..."
            class="input input-bordered w-full pl-10"
            autocomplete="off"
          />
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-base-content/50"
          />
        </form>
      </div>

      <%!-- Status filter --%>
      <div class="join w-full sm:w-auto">
        <button
          :for={
            {status, label} <- [{"all", "All"}, {"enabled", "Enabled"}, {"disabled", "Disabled"}]
          }
          phx-click="filter"
          phx-value-status={status}
          class={[
            "btn join-item flex-1 sm:flex-none",
            if(@filter_status == status, do: "btn-primary", else: "btn-ghost")
          ]}
        >
          {label}
        </button>
      </div>
    </div>

    <%!-- Endpoint list, desktop table view --%>
    <div class="hidden md:block card bg-base-100 shadow-xl">
      <div class="card-body p-0">
        <div class="max-h-[calc(100dvh-22rem)] min-h-64 overflow-auto">
          <table class="table table-zebra table-pin-rows table-sm">
            <thead>
              <tr>
                <th class="w-20">Port</th>
                <th class="w-32">Type</th>
                <th class="w-32">IP address</th>
                <th class="w-32">Profile</th>
                <th class="w-24">Status</th>
                <th class="w-24">Runtime</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="endpoints" phx-update="stream">
              <%!-- New endpoint form row --%>
              <%= if @show_new_form do %>
                <tr id="new-endpoint-row" class="bg-base-200">
                  <td>
                    <input
                      type="number"
                      name="port"
                      form="new-endpoint-form"
                      class="input input-bordered input-sm w-20 font-mono"
                      placeholder="1080"
                      min="1"
                      max="65535"
                      required
                    />
                  </td>
                  <td>
                    <select
                      name="type"
                      form="new-endpoint-form"
                      class="select select-bordered select-sm w-full"
                      required
                    >
                      <option value="socks5">SOCKS5</option>
                      <option value="http">HTTP</option>
                      <option value="auto">Auto-detect</option>
                      <option value="http_to_socks5">HTTP → SOCKS5</option>
                    </select>
                  </td>
                  <td>
                    <input
                      type="text"
                      name="ip"
                      form="new-endpoint-form"
                      class="input input-bordered input-sm w-32 font-mono"
                      placeholder="127.0.0.1"
                      value="127.0.0.1"
                      required
                    />
                  </td>
                  <td>
                    <select
                      name="profile"
                      form="new-endpoint-form"
                      class="select select-bordered select-sm w-full"
                    >
                      <option value="">None</option>
                      <option :for={profile <- @profiles} value={profile.name}>
                        {profile.name}
                      </option>
                    </select>
                  </td>
                  <td>
                    <select
                      name="enable"
                      form="new-endpoint-form"
                      class="select select-bordered select-sm w-24"
                    >
                      <option value="true" selected>Enabled</option>
                      <option value="false">Disabled</option>
                    </select>
                  </td>
                  <td>
                    <span class="badge badge-ghost gap-1 whitespace-nowrap">
                      <span class="inline-block size-2 rounded-full bg-base-content/30"></span>
                      Not created
                    </span>
                  </td>
                  <td>
                    <span class="text-xs text-base-content/60">Pending</span>
                  </td>
                  <td>
                    <form id="new-endpoint-form" phx-submit="save_new">
                      <div class="flex justify-end gap-2">
                        <button type="submit" class="btn btn-sm btn-success gap-1" title="Create">
                          <.icon name="hero-check" class="size-4" />
                        </button>
                        <button
                          type="button"
                          phx-click="cancel_new"
                          class="btn btn-sm btn-ghost"
                          title="Cancel"
                        >
                          <.icon name="hero-x-mark" class="size-4" />
                        </button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% end %>

              <tr :if={@endpoints_empty? && !@show_new_form} id="empty-state">
                <td colspan="7" class="text-center py-8 text-base-content/60">
                  <%= if @search_query != "" || @filter_status != "all" do %>
                    No matching endpoint
                  <% else %>
                    No endpoints yet, create one with the button above
                  <% end %>
                </td>
              </tr>
              <tr :for={{id, endpoint} <- @streams.endpoints} id={id} class="hover">
                <%= if @editing_port == endpoint.port do %>
                  <%!-- Edit mode --%>
                  <td>
                    <input
                      type="number"
                      name="new_port"
                      value={endpoint.port}
                      form={"edit-form-#{endpoint.port}"}
                      class="input input-bordered input-sm w-20 font-mono"
                      min="1"
                      max="65535"
                      required
                    />
                  </td>
                  <td>
                    <select
                      name="type"
                      form={"edit-form-#{endpoint.port}"}
                      class="select select-bordered select-sm w-full"
                      required
                    >
                      <option value="socks5" selected={endpoint.type == :socks5}>SOCKS5</option>
                      <option value="http" selected={endpoint.type == :http}>HTTP</option>
                      <option value="auto" selected={endpoint.type == :auto}>Auto-detect</option>
                      <option value="http_to_socks5" selected={endpoint.type == :http_to_socks5}>
                        HTTP → SOCKS5
                      </option>
                    </select>
                  </td>
                  <td>
                    <input
                      type="text"
                      name="ip"
                      value={format_ip(endpoint.ip)}
                      form={"edit-form-#{endpoint.port}"}
                      class="input input-bordered input-sm w-32 font-mono"
                      placeholder="127.0.0.1"
                      required
                    />
                  </td>
                  <td>
                    <select
                      name="profile"
                      form={"edit-form-#{endpoint.port}"}
                      class="select select-bordered select-sm w-full"
                    >
                      <option value="">None</option>
                      <option
                        :for={profile <- @profiles}
                        value={profile.name}
                        selected={Keyword.get(endpoint.options, :profile) == profile.name}
                      >
                        {profile.name}
                      </option>
                    </select>
                  </td>
                  <td>
                    <select
                      name="enable"
                      form={"edit-form-#{endpoint.port}"}
                      class="select select-bordered select-sm w-24"
                    >
                      <option value="true" selected={endpoint.enable}>Enabled</option>
                      <option value="false" selected={!endpoint.enable}>Disabled</option>
                    </select>
                  </td>
                  <td>
                    <%= if running?(endpoint) do %>
                      <span class="badge badge-info gap-1 whitespace-nowrap">
                        <span class="inline-block size-2 rounded-full bg-info-content animate-pulse"></span>
                        Running
                      </span>
                    <% else %>
                      <span class="badge badge-ghost gap-1 whitespace-nowrap">
                        <span class="inline-block size-2 rounded-full bg-base-content/30"></span>
                        Stopped
                      </span>
                    <% end %>
                  </td>
                  <td>
                    <form
                      id={"edit-form-#{endpoint.port}"}
                      phx-submit="save_edit"
                    >
                      <input type="hidden" name="port" value={endpoint.port} />
                      <div class="flex justify-end gap-2">
                        <button type="submit" class="btn btn-sm btn-success gap-1" title="Save">
                          <.icon name="hero-check" class="size-4" />
                        </button>
                        <button
                          type="button"
                          phx-click="cancel_edit"
                          class="btn btn-sm btn-ghost"
                          title="Cancel"
                        >
                          <.icon name="hero-x-mark" class="size-4" />
                        </button>
                      </div>
                    </form>
                  </td>
                <% else %>
                  <%!-- Read-only mode --%>
                  <td class="font-mono font-semibold">{endpoint.port}</td>
                  <td>
                    <span class="badge badge-outline whitespace-nowrap">
                      {type_label(endpoint.type)}
                    </span>
                  </td>
                  <td class="font-mono text-sm">{format_ip(endpoint.ip)}</td>
                  <td>
                    <%= if profile_name = Keyword.get(endpoint.options, :profile) do %>
                      <span class="badge badge-primary badge-sm">{profile_name}</span>
                    <% else %>
                      <span class="text-xs text-base-content/40">None</span>
                    <% end %>
                  </td>
                  <td>
                    <%= if endpoint.enable do %>
                      <span class="badge badge-success gap-1 whitespace-nowrap">
                        <.icon name="hero-check-circle" class="size-4" /> Enabled
                      </span>
                    <% else %>
                      <span class="badge badge-ghost gap-1 whitespace-nowrap">
                        <.icon name="hero-x-circle" class="size-4" /> Disabled
                      </span>
                    <% end %>
                  </td>
                  <td>
                    <%= if running?(endpoint) do %>
                      <span class="badge badge-info gap-1 whitespace-nowrap">
                        <span class="inline-block size-2 rounded-full bg-info-content animate-pulse"></span>
                        Running
                      </span>
                    <% else %>
                      <span class="badge badge-ghost gap-1 whitespace-nowrap">
                        <span class="inline-block size-2 rounded-full bg-base-content/30"></span>
                        Stopped
                      </span>
                    <% end %>
                  </td>
                  <td>
                    <div class="flex justify-end gap-2">
                      <%!-- Enable/disable toggle --%>
                      <button
                        phx-click="toggle_enable"
                        phx-value-port={endpoint.port}
                        class="btn btn-sm btn-ghost"
                        title={if endpoint.enable, do: "Disable", else: "Enable"}
                      >
                        <%= if endpoint.enable do %>
                          <.icon name="hero-pause" class="size-4" />
                        <% else %>
                          <.icon name="hero-play" class="size-4" />
                        <% end %>
                      </button>
                      <%!-- Restart --%>
                      <button
                        :if={endpoint.enable && running?(endpoint)}
                        phx-click="restart"
                        phx-value-port={endpoint.port}
                        class="btn btn-sm btn-ghost"
                        title="Restart"
                      >
                        <.icon name="hero-arrow-path" class="size-4" />
                      </button>
                      <%!-- Edit --%>
                      <button
                        phx-click="start_edit"
                        phx-value-port={endpoint.port}
                        class="btn btn-sm btn-ghost"
                        title="Edit"
                      >
                        <.icon name="hero-pencil" class="size-4" />
                      </button>
                      <%!-- Delete --%>
                      <button
                        phx-click="delete_confirm"
                        phx-value-port={endpoint.port}
                        class="btn btn-sm btn-ghost text-error hover:bg-error/10"
                        title="Delete"
                      >
                        <.icon name="hero-trash" class="size-4" />
                      </button>
                    </div>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%!-- Endpoint list, mobile card view --%>
    <div class="md:hidden space-y-3">
      <%!-- New endpoint form card --%>
      <%= if @show_new_form do %>
        <div class="card border border-primary/40 bg-base-100 shadow-lg">
          <div class="card-body p-4">
            <h3 class="card-title mb-3 text-base">New Endpoint</h3>
            <form id="new-endpoint-form-mobile" phx-submit="save_new" class="space-y-3">
              <div>
                <label class="label label-text text-xs">Port</label>
                <input
                  type="number"
                  name="port"
                  class="input input-bordered input-sm w-full font-mono"
                  placeholder="1080"
                  min="1"
                  max="65535"
                  required
                />
              </div>
              <div>
                <label class="label label-text text-xs">Type</label>
                <select name="type" class="select select-bordered select-sm w-full" required>
                  <option value="socks5">SOCKS5</option>
                  <option value="http">HTTP</option>
                  <option value="auto">Auto-detect</option>
                  <option value="http_to_socks5">HTTP → SOCKS5</option>
                </select>
              </div>
              <div>
                <label class="label label-text text-xs">IP address</label>
                <input
                  type="text"
                  name="ip"
                  class="input input-bordered input-sm w-full font-mono"
                  placeholder="127.0.0.1"
                  value="127.0.0.1"
                  required
                />
              </div>
              <div>
                <label class="label label-text text-xs">Profile</label>
                <select name="profile" class="select select-bordered select-sm w-full">
                  <option value="">None</option>
                  <option :for={profile <- @profiles} value={profile.name}>
                    {profile.name}
                  </option>
                </select>
              </div>
              <div>
                <label class="label label-text text-xs">Status</label>
                <select name="enable" class="select select-bordered select-sm w-full">
                  <option value="true" selected>Enabled</option>
                  <option value="false">Disabled</option>
                </select>
              </div>
              <div class="flex gap-2 pt-2">
                <button type="submit" class="btn btn-success btn-sm flex-1 gap-1">
                  <.icon name="hero-check" class="size-4" /> Create
                </button>
                <button
                  type="button"
                  phx-click="cancel_new"
                  class="btn btn-ghost btn-sm flex-1"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>
        </div>
      <% end %>

      <%!-- Empty state --%>
      <%= if @endpoints_empty? && !@show_new_form do %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body text-center py-12">
            <p class="text-base-content/60">
              <%= if @search_query != "" || @filter_status != "all" do %>
                No matching endpoint
              <% else %>
                No endpoints yet, create one with the button above
              <% end %>
            </p>
          </div>
        </div>
      <% end %>

      <%!-- Endpoint cards. Rendered from @endpoints rather than a second
           `phx-update="stream"` container — see the comment on load_endpoints/1. --%>
      <div id="endpoints-mobile" class="space-y-3">
        <div
          :for={endpoint <- @endpoints}
          id={"endpoint-#{endpoint.port}-mobile"}
          class="card bg-base-100 shadow-lg"
        >
          <div class="card-body p-4">
            <%= if @editing_port == endpoint.port do %>
              <%!-- Edit mode --%>
              <form
                id={"edit-form-mobile-#{endpoint.port}"}
                phx-submit="save_edit"
                class="space-y-3"
              >
                <input type="hidden" name="port" value={endpoint.port} />
                <div>
                  <label class="label label-text text-xs">Port</label>
                  <input
                    type="number"
                    name="new_port"
                    value={endpoint.port}
                    class="input input-bordered input-sm w-full font-mono"
                    min="1"
                    max="65535"
                    required
                  />
                </div>
                <div>
                  <label class="label label-text text-xs">Type</label>
                  <select name="type" class="select select-bordered select-sm w-full" required>
                    <option value="socks5" selected={endpoint.type == :socks5}>SOCKS5</option>
                    <option value="http" selected={endpoint.type == :http}>HTTP</option>
                    <option value="auto" selected={endpoint.type == :auto}>Auto-detect</option>
                    <option value="http_to_socks5" selected={endpoint.type == :http_to_socks5}>
                      HTTP → SOCKS5
                    </option>
                  </select>
                </div>
                <div>
                  <label class="label label-text text-xs">IP address</label>
                  <input
                    type="text"
                    name="ip"
                    value={format_ip(endpoint.ip)}
                    class="input input-bordered input-sm w-full font-mono"
                    placeholder="127.0.0.1"
                    required
                  />
                </div>
                <div>
                  <label class="label label-text text-xs">Profile</label>
                  <select name="profile" class="select select-bordered select-sm w-full">
                    <option value="">None</option>
                    <option
                      :for={profile <- @profiles}
                      value={profile.name}
                      selected={Keyword.get(endpoint.options, :profile) == profile.name}
                    >
                      {profile.name}
                    </option>
                  </select>
                </div>
                <div>
                  <label class="label label-text text-xs">Status</label>
                  <select name="enable" class="select select-bordered select-sm w-full">
                    <option value="true" selected={endpoint.enable}>Enabled</option>
                    <option value="false" selected={!endpoint.enable}>Disabled</option>
                  </select>
                </div>
                <div class="flex gap-2 pt-2">
                  <button type="submit" class="btn btn-success btn-sm flex-1 gap-1">
                    <.icon name="hero-check" class="size-4" /> Save
                  </button>
                  <button
                    type="button"
                    phx-click="cancel_edit"
                    class="btn btn-ghost btn-sm flex-1"
                  >
                    Cancel
                  </button>
                </div>
              </form>
            <% else %>
              <%!-- Read-only mode --%>
              <div class="flex justify-between items-start mb-3">
                <div>
                  <h3 class="font-bold text-lg font-mono">{endpoint.port}</h3>
                  <div class="flex gap-2 mt-1 flex-wrap">
                    <span class="badge badge-outline badge-sm">{type_label(endpoint.type)}</span>
                    <%= if endpoint.enable do %>
                      <span class="badge badge-success badge-sm gap-1">
                        <.icon name="hero-check-circle" class="size-3" /> Enabled
                      </span>
                    <% else %>
                      <span class="badge badge-ghost badge-sm gap-1">
                        <.icon name="hero-x-circle" class="size-3" /> Disabled
                      </span>
                    <% end %>
                  </div>
                </div>
                <%= if running?(endpoint) do %>
                  <span class="badge badge-info badge-sm gap-1">
                    <span class="inline-block size-2 rounded-full bg-info-content animate-pulse"></span>
                    Running
                  </span>
                <% else %>
                  <span class="badge badge-ghost badge-sm gap-1">
                    <span class="inline-block size-2 rounded-full bg-base-content/30"></span>
                    Stopped
                  </span>
                <% end %>
              </div>
              <div class="text-sm text-base-content/70 mb-3 space-y-1">
                <p class="font-mono">{format_ip(endpoint.ip)}</p>
                <%= if profile_name = Keyword.get(endpoint.options, :profile) do %>
                  <p class="flex items-center gap-1">
                    <span class="text-xs text-base-content/50">Profile:</span>
                    <span class="badge badge-primary badge-xs">{profile_name}</span>
                  </p>
                <% end %>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <button
                  phx-click="toggle_enable"
                  phx-value-port={endpoint.port}
                  class="btn btn-sm btn-ghost min-w-28 flex-1"
                >
                  <%= if endpoint.enable do %>
                    <.icon name="hero-pause" class="size-4" /> Disable
                  <% else %>
                    <.icon name="hero-play" class="size-4" /> Enable
                  <% end %>
                </button>
                <button
                  :if={endpoint.enable && running?(endpoint)}
                  phx-click="restart"
                  phx-value-port={endpoint.port}
                  class="btn btn-square btn-sm btn-ghost"
                  aria-label="Restart"
                >
                  <.icon name="hero-arrow-path" class="size-4" />
                </button>
                <button
                  phx-click="start_edit"
                  phx-value-port={endpoint.port}
                  class="btn btn-square btn-sm btn-ghost"
                  aria-label="Edit"
                >
                  <.icon name="hero-pencil" class="size-4" />
                </button>
                <button
                  phx-click="delete_confirm"
                  phx-value-port={endpoint.port}
                  class="btn btn-square btn-sm btn-ghost text-error"
                  aria-label="Delete"
                >
                  <.icon name="hero-trash" class="size-4" />
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%!-- Delete confirmation dialog --%>
    <%= if @delete_port do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <h3 class="mb-4 text-lg font-bold">Confirm deletion</h3>
          <p class="py-4">
            Delete the endpoint on port <span class="font-mono font-bold">{@delete_port}</span>?
          </p>
          <p class="text-sm text-warning">
            <.icon name="hero-exclamation-triangle" class="size-4 inline" />
            This stops the listener and removes its configuration.
          </p>
          <div class="modal-action">
            <button phx-click="delete_cancel" class="btn btn-ghost">
              Cancel
            </button>
            <button
              phx-click="delete"
              phx-value-port={@delete_port}
              class="btn btn-error"
            >
              Delete
            </button>
          </div>
        </div>
        <label class="modal-backdrop" phx-click="delete_cancel">Close</label>
      </div>
    <% end %>
  </div>
</Layouts.app>
